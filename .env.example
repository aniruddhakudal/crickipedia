PORT=3000

# pglite = local file DB (no account)
# pg or supabase = hosted Postgres (paste DATABASE_URL)
DATABASE_DRIVER=pglite
DATABASE_URL=
# If DATABASE_DRIVER=supabase but the pooler host cannot be resolved (ENOTFOUND on VPN), use pglite locally or set DATABASE_FALLBACK_PG_LITE=0 to fail fast.

# Required for Supabase Postgres (Project Settings → Database → Connection string → Session pooler)
# Example: postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Required for player photos in Supabase Storage (Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=player-photos

SESSION_SECRET=change-this-session-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Razorpay (Dashboard → API Keys). Without these, Pay uses demo mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret (Dashboard → Webhooks → payment.captured → https://your-host/api/webhooks/razorpay)
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Cloud API (automatic reserved / confirmed / rejected messages)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Meta → WhatsApp → Configuration → Webhook callback https://crickipedia.srpl.website/api/webhooks/whatsapp
# Use the same string in Meta "Verify token" and here:
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_WEBHOOK_LOG=1
